			HexBox.Text = ("#%02X%02X%02X"):format(
				math.floor(colour.R * 255 + 0.5),
				math.floor(colour.G * 255 + 0.5),
				math.floor(colour.B * 255 + 0.5))
			if not skipCallback then task.spawn(callback, colour) end
		end

		function Colorpicker:Set(colour, skipCallback)
			h, s, v = Color3.toHSV(colour)
			Apply(skipCallback)
		end
		function Colorpicker:Get() return Colorpicker.Value end

		local function ClosePopup()
			if not Colorpicker.Open then return end
			Colorpicker.Open = false
			Tween(Popup, { Size = UDim2.fromOffset(188, 0) }, TI_FAST)
			task.delay(0.13, function()
				if not Colorpicker.Open then Popup.Visible = false end
			end)
			if Library._PopupFrame == Popup then
				Library._PopupFrame = nil
				Library._PopupOwner = nil
			end
		end

		Connect(Swatch.MouseButton1Click, function()
			if Colorpicker.Open then ClosePopup() return end
			CloseActivePopup()
			Colorpicker.Open = true
			ActivePopup = ClosePopup
			Library._PopupFrame    = Popup
			Library._PopupOwner    = Swatch
			Library._PopupOpenedAt = os.clock()

			local below = Swatch.AbsolutePosition.Y + Swatch.AbsoluteSize.Y + 4
			local y = below
			if below + POPUP_H > Viewport().Y - 4 then
				local above = Swatch.AbsolutePosition.Y - POPUP_H - 4
				if above >= 4 then y = above end
			end

			Popup.Visible  = true
			Popup.Position = UDim2.fromOffset(
				math.max(4, Swatch.AbsolutePosition.X + Swatch.AbsoluteSize.X - 188), y)
			Popup.Size = UDim2.fromOffset(188, 0)
			Tween(Popup, { Size = UDim2.fromOffset(188, POPUP_H) }, TI_MED)
		end)

		local svDrag, hueDrag = false, false
		local function UpdateSV(input)
			local rx = math.clamp((input.Position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
			local ry = math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
			s, v = rx, 1 - ry
			Apply()
		end
		local function UpdateHue(input)
			h = math.clamp((input.Position.X - Hue.AbsolutePosition.X) / Hue.AbsoluteSize.X, 0, 1)
			Apply()
		end

		Connect(SV.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then svDrag = true ; UpdateSV(input) end
		end)
		Connect(Hue.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then hueDrag = true ; UpdateHue(input) end
		end)
		Connect(UserInputService.InputChanged, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
			if svDrag  then UpdateSV(input)  end
			if hueDrag then UpdateHue(input) end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then svDrag, hueDrag = false, false end
		end)

		Connect(HexBox.FocusLost, function()
			local hex = HexBox.Text:gsub("#", "")
			local n = tonumber(hex, 16)
			if #hex == 6 and n then
				Colorpicker:Set(Color3.fromRGB(
					math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256))
			else
				Apply(true)
			end
		end)

		Library.Options[flag] = Colorpicker
		Apply(true)

		if nested then
			-- shares the host toggle's row; the toggle owns its visibility
			Colorpicker.Row = row
			return Colorpicker
		end
		return RegisterElement(Colorpicker, cfg, row, text, groupbox)
	end

	function api:AddColorpicker(cfg) return BuildColorpicker(cfg) end
	function api:_NestedColorpicker(cfg) return BuildColorpicker(cfg) end

	api.AddColorPicker = api.AddColorpicker
	api.AddTextBox     = api.AddTextbox
	api.AddDropDown    = api.AddDropdown

	return api
end

