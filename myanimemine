----------------------------------------------------------------------
-- game bindings
--
-- Everything here is READ from replicated state. The mine is entirely
-- server-authoritative: during normal play the client sends nothing except
-- crew rig requests, so there is no mining loop to drive from here — the
-- crew mines whether the menu is open or not.
----------------------------------------------------------------------
local GameState = (function()
	local ok, mod = pcall(function() return require(ReplicatedStorage.Modules.GameState) end)
	return ok and mod or nil
end)()

local MineConfig = (function()
	local ok, mod = pcall(function() return require(ReplicatedStorage.Modules.MineConfig) end)
	return ok and mod or nil
end)()

local function Data()
	if not GameState then return nil end
	local ok, d = pcall(function() return GameState.GetData2() end)
	return ok and type(d) == "table" and d or nil
end

local function MineData()
	local d = Data()
	return d and type(d.MineGame) == "table" and d.MineGame or nil
end

local function MyPlot()
	local world = workspace:FindFirstChild("MineWorld")
	local plots = world and world:FindFirstChild("Plots")
	if not plots then return nil end

	for _, p in ipairs(plots:GetChildren()) do
		if p:GetAttribute("Owner") == LocalPlayer.UserId
		or p:GetAttribute("OwnerName") == LocalPlayer.Name then
			return p
		end
	end

	-- fall back to the plot whose owner billboard carries our name
	for _, p in ipairs(plots:GetChildren()) do
		for _, d in ipairs(p:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text:find(LocalPlayer.Name, 1, true) then
				return p
			end
		end
	end
	return nil
end

local function MyNodes()
	local plot = MyPlot()
	local folder = plot and plot:FindFirstChild("Nodes")
	return folder and folder:GetChildren() or {}, plot
end

local function Comma(n)
	n = tostring(math.floor(tonumber(n) or 0))
	local out = n:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

----------------------------------------------------------------------
-- actions
--
-- The mine's client scripts never call FireServer. Everything goes through a
-- single dispatcher, read out of ReplicatedStorage.Modules.GameState:
--
--     function GameState.SendEvent(name, ...)
--         ReplicatedStorage.Remotes.GamestateEvent:FireServer(name, ...)
--
-- so these calls are the exact shape the game sends itself. Every event name
-- and argument below was read from the game's own client source, not guessed:
--
--     MineSellItems   MineSellClient      SendEvent("MineSellItems", {keys})
--     MineTakeChest   MineChestClient     SendEvent("MineTakeChest")
--     MineSelectZone  MineZoneBoardClient SendEvent("MineSelectZone", zone)
--     MineAutoSellSet MineAutoSellClient  SendEvent("MineAutoSellSet", key, want)
--     UseCode         CodesFrame          SendEvent("UseCode", code)
--     MineBuffModeClaim  MineBuffPadClient SendEvent("MineBuffModeClaim")
----------------------------------------------------------------------
local MineInventory = (function()
	local ok, mod = pcall(function()
		return require(ReplicatedStorage.Modules.MineInventory)
	end)
	return ok and mod or nil
end)()

local function Send(event, ...)
	if not GameState or type(GameState.SendEvent) ~= "function" then
		return false, "GameState.SendEvent unavailable"
	end
	local ok, err = pcall(GameState.SendEvent, event, ...)
	if not ok then return false, tostring(err) end
	return true
end

-- Gear must never be swept up by a sell-all. MineTradeClient excludes these
-- same kinds from its own stack handling.
local PROTECTED_KINDS = { Pickaxe = true, BaseSkin = true, Character = true }

-- MineInventory.Collect(data, "All") is the game's own enumerator; entries
-- carry .Key, .Kind and .Count. Reading keys live means this works for any
-- player's inventory instead of a hardcoded list.
local function SellableKeys()
	local mg = MineData()
	if not mg then return {}, "no save data yet" end
	if not MineInventory then return {}, "MineInventory module missing" end

	local ok, entries = pcall(MineInventory.Collect, mg, "All")
	if not ok or type(entries) ~= "table" then return {}, "inventory read failed" end

	local protect = Library.Flags.sell_protect_gear ~= false
	local keys = {}
	for _, e in ipairs(entries) do
		if type(e) == "table" and e.Key and (tonumber(e.Count) or 0) > 0 then
			if not (protect and PROTECTED_KINDS[e.Kind]) then
				table.insert(keys, e.Key)
			end
		end
	end
	return keys
end

local Actions = {}

function Actions.Sell()
	local keys, why = SellableKeys()
	if #keys == 0 then return false, why or "nothing to sell" end
	local ok, err = Send("MineSellItems", keys)
	return ok, ok and ("sold " .. #keys .. " stacks") or err
end

function Actions.CollectChest()
	local mg = MineData()
	if not mg or next(mg.Chest or {}) == nil then return false, "chest is empty" end
	local ok, err = Send("MineTakeChest")
	return ok, ok and "chest collected" or err
end

function Actions.BuffMode()
	local ok, err = Send("MineBuffModeClaim")
	return ok, ok and "buff claimed" or err
end

function Actions.SelectZone(zone)
	if not zone or zone == "" then return false, "no zone selected" end
	local ok, err = Send("MineSelectZone", zone)
	return ok, ok and ("travelling to " .. tostring(zone)) or err
end

function Actions.SetAutoSell(key, want)
	if not key then return false, "no item key" end
	local ok, err = Send("MineAutoSellSet", key, want and true or false)
	return ok, ok and "auto-sell updated" or err
end

function Actions.UseCode(code)
	if not code or code == "" then return false, "enter a code first" end
	local ok, err = Send("UseCode", code)
	return ok, ok and ("sent code " .. code) or err
end

-- Repeated identical failures are reported once; a loop that finds nothing to
-- do should not spam the notification stack every tick.
local warned = {}

local function RunAction(name, ...)
	local fn = Actions[name]
	if not fn then return false, name .. ": unknown action" end

	local ok, msg = fn(...)
	if not ok then
		local sig = name .. "|" .. tostring(msg)
		if not warned[sig] then
			warned[sig] = true
			Library:Notify(name .. ": " .. tostring(msg), 5)
		end
	else
		warned[name] = nil
	end
	return ok, msg
end

