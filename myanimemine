local TI_FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TI_MED  = TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function Tween(inst, props, info)
	local t = TweenService:Create(inst, info or TI_FAST, props)
	t:Play()
	return t
end

local function Round(n, decimals)
	local m = 10 ^ (decimals or 0)
	return math.floor(n * m + 0.5) / m
end

-- `point` optional; without it the current mouse location is used. Mouse
-- coords exclude the topbar inset, AbsolutePosition (IgnoreGuiInset) includes it.
local function MouseIn(gui, point)
	if not gui or not gui.Visible then return false end
	local inset = GuiService:GetGuiInset()
	local m = point or UserInputService:GetMouseLocation()
	local mx, my = m.X + inset.X, m.Y + inset.Y
	local pos, sz = gui.AbsolutePosition, gui.AbsoluteSize
	return mx >= pos.X and mx <= pos.X + sz.X and my >= pos.Y and my <= pos.Y + sz.Y
end

local function KeyName(key)
	if typeof(key) == "EnumItem" then
		if key.EnumType == Enum.UserInputType then
			local map = { MouseButton1 = "MOUSE1", MouseButton2 = "MOUSE2", MouseButton3 = "MOUSE3" }
			return map[key.Name] or key.Name:upper()
		end
		local n = key.Name
		n = n:gsub("^Left", "L"):gsub("^Right", "R")
		return n:upper()
	end
	return "NONE"
end

