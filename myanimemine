		BackgroundColor3 = Color3.fromRGB(12, 14, 18),
		BorderSizePixel  = 0,
		Size             = UDim2.fromOffset(iconS, iconS),
		ZIndex           = 805,
		Parent           = Target,
	})
	Corner(IconFrame, 2)
	New("UIStroke", { Color = UNFILL, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = IconFrame })

	local IconFallback = New("TextLabel", {
		BackgroundTransparency = 1,
		Size                   = UDim2.fromScale(1, 1),
		Font                   = Library.Font,
		Text                   = utf8.char(0x56DE),
		TextColor3             = UNFILL,
		TextSize               = math.floor(iconS * 0.41),
		TextTransparency       = 1,
		ZIndex                 = 806,
		Parent                 = IconFrame,
	})

	-- GameIcon keys off the UNIVERSE id (game.GameId), not the place id —
	-- the place-id form silently never loads.
	local Icon = New("ImageLabel", {
		BackgroundTransparency = 1,
		Image                  = ("rbxthumb://type=GameIcon&id=%d&w=256&h=256"):format(game.GameId),
		Position               = UDim2.fromOffset(1, 1),
		Size                   = UDim2.new(1, -2, 1, -2),
		ZIndex                 = 807,
		Parent                 = IconFrame,
	})
