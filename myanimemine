	local Plate = New("Frame", {
		BackgroundTransparency = 1,
		Position               = UDim2.fromOffset(iconS + 18, 0),
		Size                   = UDim2.fromOffset(plateW - iconS - 18, iconS),
		ZIndex                 = 805,
		Parent                 = Target,
	})

	local accentTick = New("Frame", {
		BackgroundTransparency = 0.55,
		BorderSizePixel        = 0,
		Position               = UDim2.fromOffset(0, 32),
		Size                   = UDim2.fromOffset(40, 1),
		ZIndex                 = 806,
		Parent                 = Plate,
	})
	Paint(accentTick, "BackgroundColor3", "Accent")

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position               = UDim2.fromOffset(0, 42),
		Size                   = UDim2.new(1, 0, 0, 13),
		Font                   = MONO,
		Text                   = "TARGET",
		TextColor3             = UNFILL,
		TextSize               = 10,
		TextXAlignment         = Enum.TextXAlignment.Left,
		ZIndex                 = 806,
		Parent                 = Plate,
	})

	local PlaceName = New("TextLabel", {
		BackgroundTransparency = 1,
		Position               = UDim2.fromOffset(0, 58),
		Size                   = UDim2.new(1, 0, 0, 44),
		Font                   = Library.FontBold,
		Text                   = (game.Name ~= "" and game.Name) or "unknown place",
		TextSize               = IsMobile and 14 or 16,
		TextXAlignment         = Enum.TextXAlignment.Left,
		TextYAlignment         = Enum.TextYAlignment.Top,
		TextWrapped            = true,
		ZIndex                 = 806,
		Parent                 = Plate,
	})
	Paint(PlaceName, "TextColor3", "Text")

	-- The DataModel name is usually right; the catalogue name is authoritative.
	-- The same lookup carries the icon asset, used if the thumbnail route fails.
	table.insert(threads, task.spawn(function()
		local ok, info = pcall(function()
			return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
		end)
		if ok and typeof(info) == "table" and PlaceName.Parent then
			if info.Name then PlaceName.Text = tostring(info.Name) end
			if not Icon.IsLoaded and info.IconImageAssetId and info.IconImageAssetId ~= 0 then
				Icon.Image = ("rbxassetid://%d"):format(info.IconImageAssetId)
			end
		end
		task.wait(2.5)
		if Icon.Parent and not Icon.IsLoaded then
			Icon.ImageTransparency = 1
			Tween(IconFallback, { TextTransparency = 0 }, TI_MED)
		end
	end))

	----------------------------------------------------------------
	-- bottom-left: wordmark filling with progress
	----------------------------------------------------------------
	local wordBounds = TextService:GetTextSize(title, WORD, Library.FontBold, Vector2.new(9999, 400))
	local wordW, wordH = math.ceil(wordBounds.X), math.ceil(wordBounds.Y)

	local Block = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint            = Vector2.new(0, 1),
		Position               = UDim2.new(0, MARGIN, 1, -86),
		Size                   = UDim2.fromOffset(math.max(wordW, 420), 26 + wordH + 12 + 18),
		ZIndex                 = 805,
		Parent                 = Root,
	})

	local Kanji = New("TextLabel", {
		BackgroundTransparency = 1,
		Size                   = UDim2.fromOffset(260, 20),
		Font                   = Library.Font,
		Text                   = utf8.char(0x56DE) .. utf8.char(0x8DEF),
		TextSize               = 17,
		TextXAlignment         = Enum.TextXAlignment.Left,
		ZIndex                 = 806,
		Parent                 = Block,
	})
	Paint(Kanji, "TextColor3", "Accent")

	local WordHolder = New("Frame", {
		BackgroundTransparency = 1,
		Position               = UDim2.fromOffset(0, 26),
		Size                   = UDim2.fromOffset(wordW, wordH),
		ZIndex                 = 806,
		Parent                 = Block,
	})

	New("TextLabel", {
		BackgroundTransparency = 1,
		Size                   = UDim2.fromScale(1, 1),
		Font                   = Library.FontBold,
		Text                   = title,
		TextColor3             = UNFILL,
		TextSize               = WORD,
		TextXAlignment         = Enum.TextXAlignment.Left,
		ZIndex                 = 806,
		Parent                 = WordHolder,
	})

	local FillClip = New("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants       = true,
		Size                   = UDim2.fromOffset(0, wordH),
		ZIndex                 = 807,
		Parent                 = WordHolder,
	})
	local litWord = New("TextLabel", {
		BackgroundTransparency = 1,
		Size                   = UDim2.fromOffset(wordW, wordH),
		Font                   = Library.FontBold,
		Text                   = title,
		TextSize               = WORD,
		TextXAlignment         = Enum.TextXAlignment.Left,
		ZIndex                 = 807,
		Parent                 = FillClip,
	})
	Paint(litWord, "TextColor3", "Text")

	local Status = New("TextLabel", {
		BackgroundTransparency = 1,
		Position               = UDim2.fromOffset(0, 26 + wordH + 12),
		Size                   = UDim2.fromOffset(420, 18),
		Font                   = MONO,
		Text                   = config.Status or "starting up",
		TextColor3             = DIM,
		TextSize               = 13,
		TextXAlignment         = Enum.TextXAlignment.Left,
		TextTruncate           = Enum.TextTruncate.AtEnd,
		ZIndex                 = 806,
		Parent                 = Block,
	})

	----------------------------------------------------------------
	-- top-right: technical readouts
	----------------------------------------------------------------
	local Meta = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint            = Vector2.new(1, 0),
		Position               = UDim2.new(1, -MARGIN, 0, 86),
		Size                   = UDim2.fromOffset(220, 104),
		ZIndex                 = 805,
		Parent                 = Root,
	})

	local function MetaLabel(y, text, colour, size, font, token)
		local l = New("TextLabel", {
			BackgroundTransparency = 1,
			Position               = UDim2.fromOffset(0, y),
			Size                   = UDim2.fromOffset(220, size + 4),
			Font                   = font or MONO,
			Text                   = text,
			TextSize               = size,
			TextXAlignment         = Enum.TextXAlignment.Right,
			ZIndex                 = 806,
			Parent                 = Meta,
		})
		if token then Paint(l, "TextColor3", token) else l.TextColor3 = colour end
		return l
	end

	MetaLabel(0, sub ~= "" and sub:upper() or "LOADING", DIM, 11)
	local StepLabel = MetaLabel(16, totalSteps > 0 and ("00 / %02d"):format(totalSteps) or "00", nil, 13, nil, "Text")

	local metaRule = New("Frame", {
		BackgroundTransparency = 0.72,
		BorderSizePixel        = 0,
		Position               = UDim2.fromOffset(0, 42),
		Size                   = UDim2.fromOffset(220, 1),
		ZIndex                 = 806,
		Parent                 = Meta,
	})
	Paint(metaRule, "BackgroundColor3", "Accent")

	local Percent = MetaLabel(52, "0", nil, 34, Library.FontBold, "Accent")
	MetaLabel(92, ("PLACE %d"):format(game.PlaceId), UNFILL, 10)

	----------------------------------------------------------------
	-- bottom edge rule
	----------------------------------------------------------------
	local ruleBase = New("Frame", {
		BackgroundTransparency = 0.88,
		BorderSizePixel        = 0,
		Position               = UDim2.new(0, 0, 1, -1),
		Size                   = UDim2.new(1, 0, 0, 1),
		ZIndex                 = 804,
		Parent                 = Root,
	})
	Paint(ruleBase, "BackgroundColor3", "Accent")

	local Rule = New("Frame", {
		BorderSizePixel = 0,
		Position        = UDim2.new(0, 0, 1, -1),
		Size            = UDim2.new(0, 0, 0, 1),
		ZIndex          = 805,
		Parent          = Root,
	})
	Paint(Rule, "BackgroundColor3", "Accent")

	----------------------------------------------------------------
	-- blur
	----------------------------------------------------------------
	local blur
	if useBlur then
		pcall(function()
			blur = Instance.new("BlurEffect")
			blur.Size = 0
			blur.Parent = Lighting
			Tween(blur, { Size = 20 }, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
		end)
	end

	----------------------------------------------------------------
	-- entry
	----------------------------------------------------------------
	local fadeables = CollectFadeables(Root)
	for _, item in ipairs(fadeables) do
		for prop in pairs(item.props) do item.inst[prop] = 1 end
	end
	for _, item in ipairs(fadeables) do
		local goal = {}
		for prop, value in pairs(item.props) do goal[prop] = value end
		Tween(item.inst, goal, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
	end

	Block.Position = UDim2.new(0, MARGIN, 1, -68)
	Tween(Block, { Position = UDim2.new(0, MARGIN, 1, -86) },
		TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))

	----------------------------------------------------------------
	-- progress
	----------------------------------------------------------------
	local percentThread

	function Splash:SetProgress(alpha, status)
		alpha = math.clamp(alpha, 0, 1)
		Splash.Progress = alpha

		local info = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		Tween(FillClip, { Size = UDim2.fromOffset(math.floor(wordW * alpha + 0.5), wordH) }, info)
		Tween(Rule,     { Size = UDim2.new(alpha, 0, 0, 1) }, info)

		if status then Status.Text = tostring(status) end
		if totalSteps > 0 then
			StepLabel.Text = ("%02d / %02d"):format(math.min(Splash.StepsDone, totalSteps), totalSteps)
		end

		if percentThread then task.cancel(percentThread) end
		percentThread = task.spawn(function()
			local from = tonumber(Percent.Text) or 0
			local to   = math.floor(alpha * 100 + 0.5)
			local t0   = os.clock()
			while os.clock() - t0 < 0.5 do
				local k = (os.clock() - t0) / 0.5
				Percent.Text = ("%d"):format(from + (to - from) * k)
				task.wait()
			end
			Percent.Text = ("%d"):format(to)
			percentThread = nil
		end)
		table.insert(threads, percentThread)
	end

	function Splash:SetStatus(text) Status.Text = tostring(text) end
	Splash.Log = Splash.SetStatus

	function Splash:Step(status)
		Splash.StepsDone += 1
		local alpha
		if totalSteps > 0 then
			alpha = math.min(Splash.StepsDone / totalSteps, 1)
		else
			alpha = math.min(Splash.Progress + 0.15, 0.95)
		end
		Splash:SetProgress(alpha, status)
	end

	function Splash:Finish(callback)
		if finished then return end
		finished = true

		table.insert(threads, task.spawn(function()
			Splash:SetProgress(1, config.DoneStatus or "ready")

			local elapsed = os.clock() - startClock
			if elapsed < minDuration then task.wait(minDuration - elapsed) end
			task.wait(0.4)

			Tween(Block, { Position = UDim2.new(0, MARGIN, 1, -104) },
				TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
			if blur then
				Tween(blur, { Size = 0 }, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
			end

			for _, item in ipairs(fadeables) do
				if item.inst.Parent then
					local goal = {}
					for prop in pairs(item.props) do goal[prop] = 1 end
					Tween(item.inst, goal, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
				end
			end

			task.wait(0.45)
			for _, t in ipairs(threads) do pcall(task.cancel, t) end
			if blur then pcall(function() blur:Destroy() end) end
			Root:Destroy()
			if callback then task.spawn(callback) end
		end))
	end

	function Splash:Destroy()
		finished = true
		for _, t in ipairs(threads) do pcall(task.cancel, t) end
		if blur then pcall(function() blur:Destroy() end) end
		Root:Destroy()
	end

	Splash.Frame = Root
	return Splash
end

----------------------------------------------------------------------
-- elements
--
-- AttachElements gives any container the full Add* API, so groupboxes and
-- tabbox pages share one implementation.
----------------------------------------------------------------------

-- desktop value, touch value
local function M(desktop, mobile) return IsMobile and mobile or desktop end

local function AttachElements(api, Container, groupbox)

	local function Row(height)
		return New("Frame", {
			BackgroundTransparency = 1,
			Size                   = UDim2.new(1, 0, 0, height),
			ZIndex                 = 15,
			Parent                 = Container,
		})
	end

	--------------------------------------------------------
	-- LABEL / DIVIDER
	--------------------------------------------------------
	function api:AddLabel(text, wrap)
		local row = Row(M(16, 20))
		local lbl = New("TextLabel", {
			BackgroundTransparency = 1,
			Size                   = UDim2.fromScale(1, 1),
			Font                   = Library.Font,
			Text                   = tostring(text),
			TextSize               = Library.TextSize,
			TextXAlignment         = Enum.TextXAlignment.Left,
			TextWrapped            = wrap and true or false,
			ZIndex                 = 16,
			Parent                 = row,
		})
		Paint(lbl, "TextColor3", "TextDim")
		if wrap then
			row.AutomaticSize = Enum.AutomaticSize.Y
			lbl.AutomaticSize = Enum.AutomaticSize.Y
			lbl.Size = UDim2.new(1, 0, 0, 0)
		end
		local obj = { Type = "Label", Row = row }
		function obj:Set(v) lbl.Text = tostring(v) end
		return RegisterElement(obj, {}, row, text, groupbox)
	end

	function api:AddDivider()
		local row = Row(7)
		local f = New("Frame", {
			BorderSizePixel = 0,
			AnchorPoint     = Vector2.new(0, 0.5),
			Position        = UDim2.new(0, 0, 0.5, 0),
			Size            = UDim2.new(1, 0, 0, 1),
			ZIndex          = 16,
			Parent          = row,
		})
		Paint(f, "BackgroundColor3", "Border")
		return row
	end

	--------------------------------------------------------
	-- TOGGLE
	--------------------------------------------------------
	function api:AddToggle(cfg)
		cfg = cfg or {}
		local text     = cfg.Text or cfg.Name or "Toggle"
		local flag     = cfg.Flag or text
		local default  = cfg.Default and true or false
		local callback = cfg.Callback or function() end

		local row = Row(M(18, 26))
		local boxSize = M(14, 18)

		local Button = New("TextButton", {
			BackgroundTransparency = 1,
			Size                   = UDim2.fromScale(1, 1),
			Text                   = "",
			AutoButtonColor        = false,
			ZIndex                 = 16,
			Parent                 = row,
		})

		local Box = New("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position    = UDim2.new(0, 0, 0.5, 0),
			Size        = UDim2.fromOffset(boxSize, boxSize),
			ZIndex      = 17,
			Parent      = row,
		})
		Paint(Box, "BackgroundColor3", "Element")
		Corner(Box, 3)
		local BoxStroke = Stroke(Box, "BorderLight")

		local Fill = New("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint            = Vector2.new(0.5, 0.5),
			Position               = UDim2.fromScale(0.5, 0.5),
			Size                   = UDim2.fromScale(1, 1),
			ZIndex                 = 18,
			Parent                 = Box,
		})
		Paint(Fill, "BackgroundColor3", "Accent")
		Corner(Fill, 3)

		local Check = New("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint            = Vector2.new(0.5, 0.5),
			Position               = UDim2.fromScale(0.5, 0.5),
			Size                   = UDim2.fromOffset(boxSize - 4, boxSize - 4),
			Image                  = "rbxassetid://6031094667",
			ImageColor3            = Color3.new(1, 1, 1),
			ImageTransparency      = 1,
			ZIndex                 = 19,
			Parent                 = Box,
		})

		local Label = New("TextLabel", {
			BackgroundTransparency = 1,
			Position               = UDim2.fromOffset(boxSize + 8, 0),
			Size                   = UDim2.new(1, -(boxSize + 8), 1, 0),
			Font                   = Library.Font,
			Text                   = text,
			TextSize               = Library.TextSize,
			TextXAlignment         = Enum.TextXAlignment.Left,
			ZIndex                 = 17,
			Parent                 = row,
		})
		Label.TextColor3 = Theme.TextDim   -- state-driven, deliberately unpainted

		local Toggle = { Value = default, Type = "Toggle", IgnoreConfig = cfg.IgnoreConfig and true or false }
		local rightUsed = 0                 -- space taken by nested controls

		function Toggle:Set(value, skipCallback)
			Toggle.Value = value and true or false
			Library.Flags[flag] = Toggle.Value

			if Toggle.Value then
				Tween(Fill,  { BackgroundTransparency = 0 })
				Tween(Check, { ImageTransparency = 0 })
				Tween(Label, { TextColor3 = Theme.Text })
				Tween(BoxStroke, { Color = Theme.Accent })
			else
				Tween(Fill,  { BackgroundTransparency = 1 })
				Tween(Check, { ImageTransparency = 1 })
				Tween(Label, { TextColor3 = Theme.TextDim })
				Tween(BoxStroke, { Color = Theme.BorderLight })
			end

			if not skipCallback then task.spawn(callback, Toggle.Value) end
		end

		function Toggle:Get() return Toggle.Value end

		Connect(Button.MouseButton1Click, function() Toggle:Set(not Toggle.Value) end)
		Connect(Button.MouseEnter, function()
			if not Toggle.Value then Tween(Label, { TextColor3 = Theme.Text }) end
			Tween(Box, { BackgroundColor3 = Theme.ElementHover })
		end)
		Connect(Button.MouseLeave, function()
			if not Toggle.Value then Tween(Label, { TextColor3 = Theme.TextDim }) end
			Tween(Box, { BackgroundColor3 = Theme.Element })
		end)

		-- nested controls sit at the right end of this row
		function Toggle:AddKeybind(kcfg)
			kcfg = kcfg or {}
			kcfg._Host = row
			kcfg._HostOffset = rightUsed
			rightUsed += M(62, 70) + 6
			Label.Size = UDim2.new(1, -(boxSize + 8) - rightUsed, 1, 0)
			return api:_NestedKeybind(kcfg)
		end

		function Toggle:AddColorpicker(ccfg)
			ccfg = ccfg or {}
			ccfg._Host = row
			ccfg._HostOffset = rightUsed
			rightUsed += M(34, 42) + 6
			Label.Size = UDim2.new(1, -(boxSize + 8) - rightUsed, 1, 0)
			return api:_NestedColorpicker(ccfg)
		end

		Library.Options[flag] = Toggle
		Toggle:Set(default, true)
		return RegisterElement(Toggle, cfg, row, text, groupbox)
	end

	--------------------------------------------------------
	-- BUTTON
	--------------------------------------------------------
	function api:AddButton(cfg)
		cfg = cfg or {}
		local text     = cfg.Text or cfg.Name or "Button"
		local callback = cfg.Callback or function() end

		local row = Row(M(26, 34))

		local Btn = New("TextButton", {
			Size            = UDim2.fromScale(1, 1),
			Font            = Library.Font,
			Text            = text,
			TextSize        = Library.TextSize,
			AutoButtonColor = false,
			ZIndex          = 16,
			Parent          = row,
		})
		Paint(Btn, "BackgroundColor3", "Element")
		Paint(Btn, "TextColor3", "Text")
		Corner(Btn, 3)
		local st = Stroke(Btn, "BorderLight")

		Connect(Btn.MouseEnter, function()
			Tween(Btn, { BackgroundColor3 = Theme.ElementHover })
			Tween(st,  { Color = Theme.Accent })
		end)
		Connect(Btn.MouseLeave, function()
			Tween(Btn, { BackgroundColor3 = Theme.Element })
			Tween(st,  { Color = Theme.BorderLight })
		end)
		Connect(Btn.MouseButton1Down, function() Tween(Btn, { BackgroundColor3 = Theme.AccentDark }) end)
		Connect(Btn.MouseButton1Up,   function() Tween(Btn, { BackgroundColor3 = Theme.ElementHover }) end)
		Connect(Btn.MouseButton1Click, function() task.spawn(callback) end)

		local obj = { Type = "Button", Button = Btn }
		function obj:SetText(t) Btn.Text = t end
		return RegisterElement(obj, cfg, row, text, groupbox)
	end

	--------------------------------------------------------
	-- SLIDER
	--------------------------------------------------------
	function api:AddSlider(cfg)
		cfg = cfg or {}
		local text     = cfg.Text or cfg.Name or "Slider"
		local flag     = cfg.Flag or text
		local min      = cfg.Min or 0
		local max      = cfg.Max or 100
		local default  = math.clamp(cfg.Default or min, min, max)
		local decimals = cfg.Decimals or 0
		local suffix   = cfg.Suffix or ""
		local callback = cfg.Callback or function() end

		local row = Row(M(32, 42))
		local barY, barH = M(20, 26), M(8, 12)

		local Label = New("TextLabel", {
			BackgroundTransparency = 1,
			Size                   = UDim2.new(1, -70, 0, 14),
			Font                   = Library.Font,
			Text                   = text,
			TextSize               = Library.TextSize,
			TextXAlignment         = Enum.TextXAlignment.Left,
			ZIndex                 = 16,
			Parent                 = row,
		})
		Paint(Label, "TextColor3", "TextDim")

		local Value = New("TextLabel", {
			BackgroundTransparency = 1,
			AnchorPoint            = Vector2.new(1, 0),
			Position               = UDim2.new(1, 0, 0, 0),
			Size                   = UDim2.fromOffset(70, 14),
			Font                   = Library.Font,
			Text                   = tostring(default),
			TextSize               = Library.TextSize,
			TextXAlignment         = Enum.TextXAlignment.Right,
			ZIndex                 = 16,
			Parent                 = row,
		})
		Paint(Value, "TextColor3", "Text")

		local Bar = New("Frame", {
			Position = UDim2.fromOffset(0, barY),
			Size     = UDim2.new(1, 0, 0, barH),
			ZIndex   = 16,
			Parent   = row,
		})
		Paint(Bar, "BackgroundColor3", "Element")
		Corner(Bar, 3)
		Stroke(Bar, "BorderLight")

		local Fill = New("Frame", {
			BorderSizePixel = 0,
			Size            = UDim2.fromScale(0, 1),
			ZIndex          = 17,
			Parent          = Bar,
		})
		Paint(Fill, "BackgroundColor3", "Accent")
		Corner(Fill, 3)
		PaintGradient(New("UIGradient", { Parent = Fill }), "AccentDark", "Accent")

		local Knob = New("Frame", {
			BackgroundColor3 = Color3.fromRGB(240, 240, 250),
			AnchorPoint      = Vector2.new(0.5, 0.5),
			Position         = UDim2.fromScale(0, 0.5),
			Size             = UDim2.fromOffset(M(4, 6), barH + 4),
			ZIndex           = 19,
			Parent           = Bar,
		})
		Corner(Knob, 2)

		local Slider = { Value = default, Type = "Slider", IgnoreConfig = cfg.IgnoreConfig and true or false }

		function Slider:Set(value, skipCallback)
			value = math.clamp(Round(value, decimals), min, max)
			Slider.Value = value
			Library.Flags[flag] = value

			local alpha = (max - min == 0) and 0 or (value - min) / (max - min)
			Fill.Size     = UDim2.fromScale(alpha, 1)
			Knob.Position = UDim2.new(alpha, 0, 0.5, 0)
			Value.Text    = tostring(value) .. suffix

			if not skipCallback then task.spawn(callback, value) end
		end
		function Slider:Get() return Slider.Value end

		local dragging = false
		local function UpdateFromInput(input)
			local rel = (input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X
			Slider:Set(min + (max - min) * math.clamp(rel, 0, 1))
		end

		Connect(Bar.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				Tween(Knob, { Size = UDim2.fromOffset(M(4, 6), barH + 8) })
				UpdateFromInput(input)
			end
		end)
		Connect(UserInputService.InputChanged, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				UpdateFromInput(input)
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				if dragging then Tween(Knob, { Size = UDim2.fromOffset(M(4, 6), barH + 4) }) end
				dragging = false
			end
		end)
		Connect(Bar.MouseEnter, function() Tween(Label, { TextColor3 = Theme.Text }) end)
		Connect(Bar.MouseLeave, function() Tween(Label, { TextColor3 = Theme.TextDim }) end)

		Library.Options[flag] = Slider
		Slider:Set(default, true)
		return RegisterElement(Slider, cfg, row, text, groupbox)
	end

