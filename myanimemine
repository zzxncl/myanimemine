local function New(class, props, children)
	local inst = Instance.new(class)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	for _, child in ipairs(children or {}) do child.Parent = inst end
	if parent then inst.Parent = parent end
	return inst
end

local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library.Connections, c)
	return c
end

----------------------------------------------------------------------
-- theme registry
--
-- Colours are not written directly onto instances. Every themed property is
-- recorded against its token, so changing a token repaints everything that
-- uses it instead of needing the menu rebuilt.
----------------------------------------------------------------------
local Painted = {}

local function Paint(inst, prop, token)
	inst[prop] = Theme[token]
	table.insert(Painted, { inst = inst, prop = prop, token = token })
	return inst
end

local function PaintGradient(grad, tokenA, tokenB)
	grad.Color = ColorSequence.new(Theme[tokenA], Theme[tokenB])
	table.insert(Painted, { inst = grad, kind = "grad2", a = tokenA, b = tokenB })
	return grad
end

-- Lets an element drop a property out of the registry (e.g. a toggle whose
-- label colour is driven by its own state rather than a fixed token).
local function Unpaint(inst, prop)
	for i = #Painted, 1, -1 do
		local e = Painted[i]
		if e.inst == inst and e.prop == prop then table.remove(Painted, i) end
	end
end

function Library:SetTheme(patch)
	for token, colour in pairs(patch) do
		if Theme[token] ~= nil then Theme[token] = colour end
	end

	for i = #Painted, 1, -1 do
		local e = Painted[i]
		local ok = pcall(function()
			if e.kind == "grad2" then
				e.inst.Color = ColorSequence.new(Theme[e.a], Theme[e.b])
			else
				e.inst[e.prop] = Theme[e.token]
			end
		end)
		if not ok then table.remove(Painted, i) end   -- instance is gone
	end

	if Library._OnThemeChanged then pcall(Library._OnThemeChanged) end
end

function Library:SetAccent(colour)
	local h, s, v = Color3.toHSV(colour)
	Library:SetTheme({
		Accent     = colour,
		AccentDark = Color3.fromHSV(h, math.min(s * 1.05, 1), v * 0.52),
		AccentGlow = Color3.fromHSV(h, s * 0.55, math.min(v * 1.12, 1)),
	})
end

local function Corner(parent, radius)
