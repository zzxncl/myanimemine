Connect(UserInputService.InputBegan, function(input, gpe)
	if gpe then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
	and input.UserInputType ~= Enum.UserInputType.Touch then return end

	-- Snapshot the press position: by the time the deferred check runs the
	-- cursor may have moved, and this press may be the very one about to open
	-- a popup (a button's Activated fires after InputBegan).
	local point = Vector2.new(input.Position.X, input.Position.Y)

	task.defer(function()
		if not ActivePopup or not Library._PopupFrame then return end
		if os.clock() - (Library._PopupOpenedAt or 0) < 0.15 then return end
		if MouseIn(Library._PopupFrame, point) then return end
		if Library._PopupOwner and MouseIn(Library._PopupOwner, point) then return end
		CloseActivePopup()
	end)
end)

