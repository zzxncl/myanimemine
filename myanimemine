		local items    = cfg.Items or cfg.Options or {}
		local multi    = cfg.Multi and true or false
		local default  = cfg.Default
		local callback = cfg.Callback or function() end
		local maxShow  = cfg.MaxVisible or 6

		local boxH   = M(22, 30)
		local itemH  = M(20, 28)
		local row    = Row(M(34, 48))

		local lbl = New("TextLabel", {
			BackgroundTransparency = 1,
			Size                   = UDim2.new(1, 0, 0, 14),
			Font                   = Library.Font,
			Text                   = text,
			TextSize               = Library.TextSize,
			TextXAlignment         = Enum.TextXAlignment.Left,
			ZIndex                 = 16,
			Parent                 = row,
		})
		Paint(lbl, "TextColor3", "TextDim")

		local Box = New("TextButton", {
			Position        = UDim2.fromOffset(0, 16),
			Size            = UDim2.new(1, 0, 0, boxH),
			Text            = "",
			AutoButtonColor = false,
			ZIndex          = 16,
			Parent          = row,
		})
		Paint(Box, "BackgroundColor3", "Element")
		Corner(Box, 3)
		local BoxStroke = Stroke(Box, "BorderLight")

		local Display = New("TextLabel", {
			BackgroundTransparency = 1,
			Position               = UDim2.fromOffset(8, 0),
			Size                   = UDim2.new(1, -28, 1, 0),
			Font                   = Library.Font,
			Text                   = "---",
			TextSize               = Library.TextSize,
			TextXAlignment         = Enum.TextXAlignment.Left,
			TextTruncate           = Enum.TextTruncate.AtEnd,
			ZIndex                 = 17,
			Parent                 = Box,
		})
		Display.TextColor3 = Theme.Text

		local Arrow = New("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint            = Vector2.new(1, 0.5),
			Position               = UDim2.new(1, -7, 0.5, 0),
			Size                   = UDim2.fromOffset(12, 12),
			Image                  = "rbxassetid://6034818372",
			ZIndex                 = 17,
			Parent                 = Box,
		})
		Paint(Arrow, "ImageColor3", "TextDim")

		local Dropdown = {
			Value = multi and {} or nil,
			Items = items,
			Type  = "Dropdown",
			Open  = false,
			IgnoreConfig = cfg.IgnoreConfig and true or false,
		}

		local Popup = New("Frame", {
			Size             = UDim2.fromOffset(100, 0),
			Visible          = false,
			ClipsDescendants = true,
			ZIndex           = 510,
			Parent           = Overlay,
		})
		Paint(Popup, "BackgroundColor3", "Topbar")
		Corner(Popup, 3)
		Stroke(Popup, "Accent")

		local Scroll = New("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel        = 0,
			Position               = UDim2.fromOffset(0, 4),
			Size                   = UDim2.new(1, 0, 1, -8),
			CanvasSize             = UDim2.new(),
			AutomaticCanvasSize    = Enum.AutomaticSize.Y,
			ScrollBarThickness     = 2,
			ZIndex                 = 511,
			Parent                 = Popup,
		})
		Paint(Scroll, "ScrollBarImageColor3", "Accent")
		List(Scroll, 1)
		Padding(Scroll, 0, 0, 4, 4)

		local ItemButtons, ItemCount = {}, 0

		local function IsSelected(item)
			if multi then
				for _, v in ipairs(Dropdown.Value) do if v == item then return true end end
				return false
			end
			return Dropdown.Value == item
		end

		local function Refresh()
			for item, data in pairs(ItemButtons) do
				local sel = IsSelected(item)
				data.Button.BackgroundColor3 = Theme.AccentDark
				Tween(data.Button, { BackgroundTransparency = sel and 0 or 1 })
				Tween(data.Label,  { TextColor3 = sel and Theme.Text or Theme.TextDim })
			end
			if multi then
				if #Dropdown.Value == 0 then
					Display.Text = "---" ; Display.TextColor3 = Theme.TextDisabled
				else
					Display.Text = table.concat(Dropdown.Value, ", ") ; Display.TextColor3 = Theme.Text
				end
			else
				if Dropdown.Value == nil then
					Display.Text = "---" ; Display.TextColor3 = Theme.TextDisabled
				else
					Display.Text = tostring(Dropdown.Value) ; Display.TextColor3 = Theme.Text
				end
			end
		end

		local function ClosePopup()
			if not Dropdown.Open then return end
			Dropdown.Open = false
			Tween(Popup, { Size = UDim2.fromOffset(Popup.AbsoluteSize.X, 0) }, TI_FAST)
			Tween(Arrow, { Rotation = 0 })
			Tween(BoxStroke, { Color = Theme.BorderLight })
			task.delay(0.13, function()
				if not Dropdown.Open then Popup.Visible = false end
			end)
			if Library._PopupFrame == Popup then
				Library._PopupFrame = nil
				Library._PopupOwner = nil
			end
		end

		local function OpenPopup()
			CloseActivePopup()
			Dropdown.Open = true
			ActivePopup = ClosePopup
			Library._PopupFrame    = Popup
			Library._PopupOwner    = Box
			Library._PopupOpenedAt = os.clock()

			local height = math.max(itemH + 1, math.min(ItemCount, maxShow) * (itemH + 1) + 8)
			local below  = Box.AbsolutePosition.Y + Box.AbsoluteSize.Y + 3
			local y = below
			if below + height > Viewport().Y - 4 then
				local above = Box.AbsolutePosition.Y - height - 3
				if above >= 4 then y = above end
			end

			Popup.Visible  = true
			Popup.Position = UDim2.fromOffset(Box.AbsolutePosition.X, y)
			Popup.Size     = UDim2.fromOffset(Box.AbsoluteSize.X, 0)
			Tween(Popup, { Size = UDim2.fromOffset(Box.AbsoluteSize.X, height) }, TI_MED)
			Tween(Arrow, { Rotation = 180 })
			Tween(BoxStroke, { Color = Theme.Accent })
		end

		local function BuildItems(list)
			for _, data in pairs(ItemButtons) do data.Button:Destroy() end
			table.clear(ItemButtons)
			ItemCount = 0

			for i, item in ipairs(list) do
				local btn = New("TextButton", {
					BackgroundColor3       = Theme.AccentDark,
					BackgroundTransparency = 1,
					Size                   = UDim2.new(1, 0, 0, itemH),
					Text                   = "",
					AutoButtonColor        = false,
					LayoutOrder            = i,
					ZIndex                 = 512,
					Parent                 = Scroll,
				})
				Corner(btn, 3)

				local il = New("TextLabel", {
					BackgroundTransparency = 1,
					Position               = UDim2.fromOffset(7, 0),
					Size                   = UDim2.new(1, -14, 1, 0),
					Font                   = Library.Font,
					Text                   = tostring(item),
					TextSize               = Library.TextSize,
					TextXAlignment         = Enum.TextXAlignment.Left,
					TextTruncate           = Enum.TextTruncate.AtEnd,
					ZIndex                 = 513,
					Parent                 = btn,
				})
				il.TextColor3 = Theme.TextDim

				ItemButtons[item] = { Button = btn, Label = il }
				ItemCount += 1

				Connect(btn.MouseEnter, function()
					if not IsSelected(item) then
						btn.BackgroundColor3 = Theme.ElementHover
						Tween(btn, { BackgroundTransparency = 0.4 })
						Tween(il, { TextColor3 = Theme.Text })
					end
				end)
				Connect(btn.MouseLeave, function()
					if not IsSelected(item) then
						Tween(btn, { BackgroundTransparency = 1 })
						Tween(il, { TextColor3 = Theme.TextDim })
					end
				end)
				Connect(btn.MouseButton1Click, function()
					if multi then
						local found
						for idx, v in ipairs(Dropdown.Value) do
							if v == item then
								found = idx
								break
							end
						end
						if found then table.remove(Dropdown.Value, found)
						else table.insert(Dropdown.Value, item) end
						Library.Flags[flag] = Dropdown.Value
						Refresh()
						EvaluateVisibility()
						task.spawn(callback, Dropdown.Value)
					else
						Dropdown.Value = item
						Library.Flags[flag] = item
						Refresh()
						ClosePopup()
						EvaluateVisibility()
						task.spawn(callback, item)
					end
				end)
			end
		end

		function Dropdown:SetItems(list)
			Dropdown.Items = list
			BuildItems(list)
			if multi then
				for i = #Dropdown.Value, 1, -1 do
					if not ItemButtons[Dropdown.Value[i]] then table.remove(Dropdown.Value, i) end
				end
			elseif Dropdown.Value ~= nil and not ItemButtons[Dropdown.Value] then
				Dropdown.Value = nil
			end
			Refresh()
		end
		Dropdown.Refresh = Dropdown.SetItems

		function Dropdown:Set(value, skipCallback)
			if multi then
				Dropdown.Value = typeof(value) == "table" and table.clone(value) or {}
			else
				Dropdown.Value = value
			end
			Library.Flags[flag] = Dropdown.Value
			Refresh()
			if not skipCallback then task.spawn(callback, Dropdown.Value) end
		end
		function Dropdown:Get() return Dropdown.Value end

		Connect(Box.MouseButton1Click, function()
			if Dropdown.Open then ClosePopup() else OpenPopup() end
		end)
		Connect(Box.MouseEnter, function()
			if not Dropdown.Open then Tween(Box, { BackgroundColor3 = Theme.ElementHover }) end
		end)
		Connect(Box.MouseLeave, function() Tween(Box, { BackgroundColor3 = Theme.Element }) end)

		BuildItems(items)
		Library.Options[flag] = Dropdown
		Dropdown:Set(default ~= nil and default or (multi and {} or nil), true)
		Dropdown.Close = ClosePopup

		return RegisterElement(Dropdown, cfg, row, text, groupbox)
	end

