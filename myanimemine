	Mark(UDim2.fromOffset(M, M),              UDim2.fromOffset(ARM, T))
	Mark(UDim2.fromOffset(M, M),              UDim2.fromOffset(T, ARM))
	Mark(UDim2.new(1, -M - ARM, 0, M),        UDim2.fromOffset(ARM, T))
	Mark(UDim2.new(1, -M - T,   0, M),        UDim2.fromOffset(T, ARM))
	Mark(UDim2.new(0, M, 1, -M - T),          UDim2.fromOffset(ARM, T))
	Mark(UDim2.new(0, M, 1, -M - ARM),        UDim2.fromOffset(T, ARM))
	Mark(UDim2.new(1, -M - ARM, 1, -M - T),   UDim2.fromOffset(ARM, T))
	Mark(UDim2.new(1, -M - T,   1, -M - ARM), UDim2.fromOffset(T, ARM))

	----------------------------------------------------------------
	-- centre: the target game
	----------------------------------------------------------------
	local plateW = IsMobile and 300 or 392
	local iconS  = IsMobile and 104 or 132

	local Target = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint            = Vector2.new(0.5, 0.5),
