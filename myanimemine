	--------------------------------------------------------
	-- KEYBIND (standalone or nested on a toggle row)
	--------------------------------------------------------
	local function BuildKeybind(cfg)
		cfg = cfg or {}
		local text     = cfg.Text or cfg.Name or "Keybind"
		local flag     = cfg.Flag or text
		local default  = cfg.Default
		local mode     = cfg.Mode or "Toggle"
		local callback = cfg.Callback or function() end
		local onChange = cfg.Changed or function() end

		local nested = cfg._Host ~= nil
		local btnW, btnH = M(84, 96), M(20, 26)
		if nested then btnW = M(62, 70) end

		local row, Label
		if nested then
			row = cfg._Host
		else
			row = Row(M(22, 30))
			Label = New("TextLabel", {
				BackgroundTransparency = 1,
				Size                   = UDim2.new(1, -(btnW + 6), 1, 0),
				Font                   = Library.Font,
				Text                   = text,
				TextSize               = Library.TextSize,
				TextXAlignment         = Enum.TextXAlignment.Left,
				ZIndex                 = 16,
				Parent                 = row,
			})
			Paint(Label, "TextColor3", "TextDim")
		end

		local Btn = New("TextButton", {
			AnchorPoint     = Vector2.new(1, 0.5),
			Position        = UDim2.new(1, -(cfg._HostOffset or 0), 0.5, 0),
			Size            = UDim2.fromOffset(btnW, btnH),
			Font            = Library.Font,
			Text            = "NONE",
			TextSize        = Library.TextSize,
			AutoButtonColor = false,
			ZIndex          = 18,
			Parent          = row,
		})
		Paint(Btn, "BackgroundColor3", "Element")
		Corner(Btn, 3)
		local st = Stroke(Btn, "BorderLight")

		local Keybind = {
			Key = default, Mode = mode, Active = false, Type = "Keybind",
			Text = text, NoList = cfg.NoList and true or false,
			IgnoreConfig = cfg.IgnoreConfig and true or false,
		}
		local listening = false

		local function UpdateText()
			Btn.Text = listening and "..." or KeyName(Keybind.Key)
			Btn.TextColor3 = Keybind.Key and Theme.Text or Theme.TextDisabled
		end

		function Keybind:Set(key, skipCallback)
			Keybind.Key = key
			Library.Flags[flag] = key and key.Name or nil
			UpdateText()
			RefreshKeybindList()
			if not skipCallback then task.spawn(onChange, key) end
		end
		function Keybind:Get() return Keybind.Key end
		function Keybind:SetMode(m) Keybind.Mode = m end

		Connect(Btn.MouseButton1Click, function()
			listening = true
			UpdateText()
			Tween(st, { Color = Theme.Accent })
		end)
		Connect(Btn.MouseButton2Click, function() Keybind:Set(nil) end)
		Connect(Btn.MouseEnter, function()
			Tween(Btn, { BackgroundColor3 = Theme.ElementHover })
			if Label then Tween(Label, { TextColor3 = Theme.Text }) end
		end)
		Connect(Btn.MouseLeave, function()
			Tween(Btn, { BackgroundColor3 = Theme.Element })
			if Label then Tween(Label, { TextColor3 = Theme.TextDim }) end
		end)

		Connect(UserInputService.InputBegan, function(input, gpe)
			if listening then
				local key
				if input.UserInputType == Enum.UserInputType.Keyboard then
					key = input.KeyCode
					if key == Enum.KeyCode.Escape then key = nil end
				elseif input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.MouseButton2
					or input.UserInputType == Enum.UserInputType.MouseButton3 then
					if MouseIn(Btn) then return end   -- ignore the click that opened the listener
					key = input.UserInputType
				else
					return
				end
				listening = false
				Tween(st, { Color = Theme.BorderLight })
				Keybind:Set(key)
				return
			end

			if gpe or not Keybind.Key then return end
			local matched =
				(input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Keybind.Key)
				or (input.UserInputType == Keybind.Key)

			if matched then
				if Keybind.Mode == "Hold" then
					Keybind.Active = true
					task.spawn(callback, true)
				else
					Keybind.Active = not Keybind.Active
					task.spawn(callback, Keybind.Active)
				end
				RefreshKeybindList()
			end
		end)

		Connect(UserInputService.InputEnded, function(input)
			if Keybind.Mode ~= "Hold" or not Keybind.Key then return end
			local matched =
				(input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Keybind.Key)
				or (input.UserInputType == Keybind.Key)
			if matched then
				Keybind.Active = false
				task.spawn(callback, false)
				RefreshKeybindList()
			end
		end)

		table.insert(Library.Keybinds, Keybind)
		Library.Options[flag] = Keybind
		Keybind:Set(default, true)

		if nested then
			-- shares the host toggle's row; the toggle owns its visibility
			Keybind.Row = row
			return Keybind
		end
		return RegisterElement(Keybind, cfg, row, text, groupbox)
	end

	function api:AddKeybind(cfg) return BuildKeybind(cfg) end
	function api:_NestedKeybind(cfg) return BuildKeybind(cfg) end

