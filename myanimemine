	local out, cursor = {}, ""
	for _ = 1, 4 do
		local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100")
			:format(game.PlaceId)
		if cursor ~= "" then url = url .. "&cursor=" .. cursor end
		local ok, body = pcall(function() return game:HttpGet(url) end)
		if not ok then break end
		local okJson, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not okJson or typeof(data) ~= "table" or not data.data then break end
		for _, s in ipairs(data.data) do
			if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
				table.insert(out, s)
			end
		end
		cursor = data.nextPageCursor or ""
		if cursor == "" then break end
	end
	return out
end

local hopping = false
Server:AddButton({
	Text = "Server Hop",
	Callback = function()
		if hopping then return end
		hopping = true
		Library:Notify("Finding a server...")
		task.spawn(function()
			local servers = FetchServers()
			if #servers == 0 then
				Library:Notify("No other servers found", 5)
				hopping = false
				return
			end
			if Library.Flags.hop_mode == "Lowest Ping" then
				table.sort(servers, function(a, b) return (a.ping or 9999) < (b.ping or 9999) end)
			else
				table.sort(servers, function(a, b) return a.playing < b.playing end)
			end
			local t = servers[1]
			Library:Notify(("Hopping — %d players, %d ms"):format(t.playing, t.ping or 0), 5)
			local ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, t.id, LocalPlayer)
			end)
			if not ok then Library:Notify("Teleport refused", 5) hopping = false end
		end)
	end,
})

Server:AddButton({
	Text = "Rejoin Server",
	Callback = function()
		local ok = pcall(function()
