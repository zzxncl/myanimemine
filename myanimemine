		local function Apply(skipCallback)
			local colour = Color3.fromHSV(h, s, v)
			Colorpicker.Value   = colour
			Library.Flags[flag] = colour
			Swatch.BackgroundColor3 = colour
			SV.BackgroundColor3     = Color3.fromHSV(h, 1, 1)
