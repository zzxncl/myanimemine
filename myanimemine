		local function MakeShell(parent, gbName)
			local Group = New("Frame", {
				Name          = gbName,
				Size          = UDim2.new(1, 0, 0, 40),
				AutomaticSize = Enum.AutomaticSize.Y,
				ZIndex        = 13,
				Parent        = parent,
			})
			Paint(Group, "BackgroundColor3", "Group")
			Corner(Group, 3)
			Stroke(Group, "Border")

			local Header = New("Frame", {
				BorderSizePixel = 0,
				Size            = UDim2.new(1, 0, 0, 26),
				ZIndex          = 14,
				Parent          = Group,
			})
			Paint(Header, "BackgroundColor3", "GroupHeader")
			Corner(Header, 3)
			local hs = New("Frame", {
				BorderSizePixel = 0,
				Position        = UDim2.new(0, 0, 1, -4),
				Size            = UDim2.new(1, 0, 0, 4),
				ZIndex          = 14,
				Parent          = Header,
			})
			Paint(hs, "BackgroundColor3", "GroupHeader")
			local hb = New("Frame", {
				BorderSizePixel = 0,
				Position        = UDim2.new(0, 0, 1, -1),
				Size            = UDim2.new(1, 0, 0, 1),
				ZIndex          = 15,
				Parent          = Header,
			})
			Paint(hb, "BackgroundColor3", "Border")

			local Container = New("Frame", {
				BackgroundTransparency = 1,
				Position               = UDim2.fromOffset(0, 26),
				Size                   = UDim2.new(1, 0, 0, 0),
				AutomaticSize          = Enum.AutomaticSize.Y,
				ZIndex                 = 14,
				Parent                 = Group,
			})
			List(Container, 6)
			Padding(Container, 9, 10, 10, 10)

			return Group, Header, Container
		end

		function Tab:AddGroupbox(gbName, side)
			local parent = (side == "Right" or side == "right") and RightCol or LeftCol
			local Group, Header, Container = MakeShell(parent, gbName)

			local tick = New("Frame", {
				BorderSizePixel = 0,
				AnchorPoint     = Vector2.new(0, 0.5),
				Position        = UDim2.new(0, 10, 0.5, 0),
				Size            = UDim2.fromOffset(2, 11),
				ZIndex          = 16,
				Parent          = Header,
			})
			Paint(tick, "BackgroundColor3", "Accent")

			local hl = New("TextLabel", {
				BackgroundTransparency = 1,
				Position               = UDim2.fromOffset(19, 0),
				Size                   = UDim2.new(1, -28, 1, 0),
				Font                   = Library.FontBold,
				Text                   = gbName,
				TextSize               = Library.TextSize,
				TextXAlignment         = Enum.TextXAlignment.Left,
				ZIndex                 = 16,
				Parent                 = Header,
			})
			Paint(hl, "TextColor3", "Text")

			local Groupbox = { Frame = Group, Container = Container, Name = gbName }
			table.insert(Tab.Groupboxes, Groupbox)
			return AttachElements(Groupbox, Container, Groupbox)
		end

		------------------------------------------------------------
		-- tabbox (sub-tabs inside one groupbox shell)
		------------------------------------------------------------
		function Tab:AddTabbox(side)
			local parent = (side == "Right" or side == "right") and RightCol or LeftCol
			local Group, Header, Outer = MakeShell(parent, "Tabbox")
			Outer:Destroy()

			local Strip = New("Frame", {
				BackgroundTransparency = 1,
				Size                   = UDim2.fromScale(1, 1),
				ZIndex                 = 16,
				Parent                 = Header,
			})
			New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder     = Enum.SortOrder.LayoutOrder,
				Parent        = Strip,
			})

			local Body = New("Frame", {
				BackgroundTransparency = 1,
				Position               = UDim2.fromOffset(0, 26),
				Size                   = UDim2.new(1, 0, 0, 0),
				AutomaticSize          = Enum.AutomaticSize.Y,
				ZIndex                 = 14,
				Parent                 = Group,
			})

			local Tabbox = { Frame = Group, Pages = {} }

			function Tabbox:AddTab(pageName)
				local btn = New("TextButton", {
					BackgroundTransparency = 1,
					Size                   = UDim2.new(0, 0, 1, 0),
					AutomaticSize          = Enum.AutomaticSize.X,
					Font                   = Library.Font,
					Text                   = "  " .. pageName .. "  ",
					TextSize               = Library.TextSize,
					AutoButtonColor        = false,
					LayoutOrder            = #Tabbox.Pages + 1,
					ZIndex                 = 17,
					Parent                 = Strip,
				})
				btn.TextColor3 = Theme.TextDim

				local under = New("Frame", {
					BorderSizePixel = 0,
					AnchorPoint     = Vector2.new(0, 1),
					Position        = UDim2.new(0, 0, 1, 0),
					Size            = UDim2.new(1, 0, 0, 0),
					ZIndex          = 18,
					Parent          = btn,
				})
				Paint(under, "BackgroundColor3", "Accent")

				local Container = New("Frame", {
					BackgroundTransparency = 1,
					Size                   = UDim2.new(1, 0, 0, 0),
					AutomaticSize          = Enum.AutomaticSize.Y,
					Visible                = false,
					ZIndex                 = 14,
					Parent                 = Body,
				})
				List(Container, 6)
				Padding(Container, 9, 10, 10, 10)

				local page = { Button = btn, Under = under, Container = Container, Name = pageName }
				table.insert(Tabbox.Pages, page)

				local function Select()
					for _, p in ipairs(Tabbox.Pages) do
						p.Container.Visible = false
						Tween(p.Button, { TextColor3 = Theme.TextDim })
						Tween(p.Under, { Size = UDim2.new(1, 0, 0, 0) })
					end
					Container.Visible = true
					Tween(btn, { TextColor3 = Theme.Text })
					Tween(under, { Size = UDim2.new(1, 0, 0, 2) }, TI_MED)
				end
				page.Select = Select

				Connect(btn.MouseButton1Click, Select)
				Connect(btn.MouseEnter, function()
					if not Container.Visible then Tween(btn, { TextColor3 = Theme.Text }) end
				end)
				Connect(btn.MouseLeave, function()
					if not Container.Visible then Tween(btn, { TextColor3 = Theme.TextDim }) end
				end)

				if #Tabbox.Pages == 1 then Select() end

				-- each page behaves exactly like a groupbox for elements
				local api = { Frame = Group, Container = Container, Name = pageName }
				table.insert(Tab.Groupboxes, api)
				return AttachElements(api, Container, api)
			end

			return Tabbox
		end

		Tab.AddSection = Tab.AddGroupbox

		table.insert(Window.Tabs, Tab)
		if #Window.Tabs == 1 then Tab:Select() end
		return Tab
	end

	----------------------------------------------------------------
	-- window API
	----------------------------------------------------------------
	function Window:SetVisible(state)
		Main.Visible = state and true or false
		if not Main.Visible then CloseActivePopup() end
	end
	function Window:Toggle() Window:SetVisible(not Main.Visible) end
	function Window:IsVisible() return Main.Visible end

	Connect(UserInputService.InputBegan, function(input, gpe)
		if gpe then return end
		if input.UserInputType == Enum.UserInputType.Keyboard
		and input.KeyCode == Library.ToggleKey then
			Window:Toggle()
		end
	end)

	Library._OnThemeChanged = repaintAccentLine

	table.insert(Library.Windows, Window)
	Library.Window = Window
	return Window
end

----------------------------------------------------------------------
-- on-screen toggle
--
-- Touch devices have no RightShift, so without this a mobile user who closes
-- the menu can never reopen it. Created automatically on touch builds.
----------------------------------------------------------------------
local ToggleButton

function Library:CreateToggleButton(opts)
	opts = opts or {}
	if ToggleButton then return ToggleButton end

	local size = opts.Size or (IsMobile and 54 or 44)

	local Btn = New("TextButton", {
		Name            = "ToggleButton",
		AnchorPoint     = Vector2.new(0, 0),
		Position        = opts.Position or UDim2.fromOffset(16, 100),
		Size            = UDim2.fromOffset(size, size),
		Text            = "",
		AutoButtonColor = false,
		ZIndex          = 650,
		Parent          = ScreenGui,
	})
	Paint(Btn, "BackgroundColor3", "Topbar")
	New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Btn })
	Stroke(Btn, "Accent")

	-- the 回 mark, drawn as nested squares
	local outer = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint            = Vector2.new(0.5, 0.5),
		Position               = UDim2.fromScale(0.5, 0.5),
		Size                   = UDim2.fromOffset(size * 0.42, size * 0.42),
		ZIndex                 = 651,
		Parent                 = Btn,
	})
	New("UICorner", { CornerRadius = UDim.new(0, 2), Parent = outer })
	local os_ = New("UIStroke", { Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = outer })
	Paint(os_, "Color", "Accent")

	local inner = New("Frame", {
		BorderSizePixel = 0,
		AnchorPoint     = Vector2.new(0.5, 0.5),
		Position        = UDim2.fromScale(0.5, 0.5),
		Size            = UDim2.fromOffset(size * 0.14, size * 0.14),
		ZIndex          = 652,
		Parent          = outer,
	})
	Paint(inner, "BackgroundColor3", "Accent")

	-- drag it out of the way; a press that did not move counts as a tap
	local dragging, moved, startIn, startPos = false, false, nil, nil
	Connect(Btn.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved, startIn, startPos = true, false, input.Position, Btn.Position
		end
	end)
	Connect(UserInputService.InputChanged, function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - startIn
			if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then moved = true end
			local vp = Viewport()
			Btn.Position = UDim2.fromOffset(
				math.clamp(startPos.X.Offset + d.X, 0, vp.X - size),
				math.clamp(startPos.Y.Offset + d.Y, 0, vp.Y - size))
		end
	end)
	Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			if dragging and not moved then
				local w = Library.Window
				if w then w:Toggle() end
			end
			dragging = false
		end
	end)

	ToggleButton = Btn
	Library.ToggleButton = Btn
	return Btn
end

function Library:SetToggleButtonVisible(state)
	if not ToggleButton and state then Library:CreateToggleButton() end
	if ToggleButton then ToggleButton.Visible = state and true or false end
end

----------------------------------------------------------------------
-- configs
--
--   Kairo/
--     configs/<name>.json   one saved config each
--     autoload.txt          name of the config to load on startup
----------------------------------------------------------------------
local FOLDER        = "Kairo"
local CFG_FOLDER    = FOLDER .. "/configs"
local AUTOLOAD_FILE = FOLDER .. "/autoload.txt"

Library.ConfigFolder = CFG_FOLDER

local function HasFileAPI()
	return (writefile and readfile and isfile and isfolder and makefolder and listfiles) and true or false
end
Library.HasFileAPI = HasFileAPI

local function EnsureFolders()
	if not HasFileAPI() then return false end
	return (pcall(function()
		if not isfolder(FOLDER)     then makefolder(FOLDER)     end
		if not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
	end))
end

local function CleanName(name)
	if typeof(name) ~= "string" then return nil end
	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then return nil end
	if name:find("[\\/:%*%?\"<>|]") then return nil end
	return name
end
Library.CleanConfigName = CleanName

local function Serialize()
	local out = {}
	for flag, option in pairs(Library.Options) do
		if not option.IgnoreConfig then
			local t = option.Type
			if t == "Toggle" or t == "Slider" or t == "Textbox" or t == "Dropdown" then
				out[flag] = { Type = t, Value = option.Value }
			elseif t == "Keybind" then
				out[flag] = { Type = t, Value = option.Key and option.Key.Name or nil, Mode = option.Mode }
			elseif t == "Colorpicker" then
				local c = option.Value
				out[flag] = { Type = t, Value = { c.R, c.G, c.B } }
			end
		end
	end
	return out
end

function Library:GetConfigString()
	return HttpService:JSONEncode(Serialize())
end

-- Applies every saved value AND fires each callback, so a toggle that was on
-- when the config was saved actually switches its feature back on here.
function Library:LoadConfigString(json)
	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or typeof(data) ~= "table" then return false, "invalid config file" end

	local applied = 0
	for flag, saved in pairs(data) do
		local option = Library.Options[flag]
		if option and not option.IgnoreConfig and saved.Type == option.Type then
			local good = pcall(function()
				if saved.Type == "Keybind" then
					local key
					if saved.Value then
						pcall(function() key = Enum.KeyCode[saved.Value] end)
						if not key then pcall(function() key = Enum.UserInputType[saved.Value] end) end
					end
					option:Set(key)
					if saved.Mode then option:SetMode(saved.Mode) end
				elseif saved.Type == "Colorpicker" then
					local c = saved.Value
					option:Set(Color3.new(c[1], c[2], c[3]))
				else
					option:Set(saved.Value)
				end
			end)
			if good then applied += 1 end
		end
	end
	EvaluateVisibility()
	return true, applied
end

function Library:ListConfigs()
	if not EnsureFolders() then return {} end
	local out = {}
	local ok, files = pcall(listfiles, CFG_FOLDER)
	if not ok then return out end
	for _, path in ipairs(files) do
		local name = tostring(path):match("([^\\/]+)%.json$")
		if name then table.insert(out, name) end
	end
	table.sort(out)
	return out
end

function Library:ConfigExists(name)
	name = CleanName(name)
	if not name or not HasFileAPI() then return false end
	local ok, exists = pcall(isfile, CFG_FOLDER .. "/" .. name .. ".json")
	return ok and exists or false
end

function Library:SaveConfig(name)
	name = CleanName(name)
	if not name then return false, "enter a config name" end
	if not EnsureFolders() then return false, "no file API in this executor" end
	local ok, err = pcall(function()
		writefile(CFG_FOLDER .. "/" .. name .. ".json", Library:GetConfigString())
	end)
	if not ok then return false, tostring(err) end
	return true, name
end

function Library:LoadConfig(name)
	name = CleanName(name)
	if not name then return false, "no config selected" end
	if not EnsureFolders() then return false, "no file API in this executor" end
	local path = CFG_FOLDER .. "/" .. name .. ".json"
	local okExists, exists = pcall(isfile, path)
	if not okExists or not exists then return false, "config not found" end
	local okRead, content = pcall(readfile, path)
	if not okRead then return false, "could not read config" end
	return Library:LoadConfigString(content)
end

function Library:DeleteConfig(name)
	name = CleanName(name)
	if not name then return false, "no config selected" end
	if not HasFileAPI() then return false, "no file API in this executor" end
	local path = CFG_FOLDER .. "/" .. name .. ".json"
	local okExists, exists = pcall(isfile, path)
	if not okExists or not exists then return false, "config not found" end
	if not delfile then return false, "executor cannot delete files" end
	if not pcall(delfile, path) then return false, "delete failed" end
	if Library:GetAutoloadConfig() == name then Library:ClearAutoloadConfig() end
	return true, name
end

----------------------------------------------------------------------
-- sharing
----------------------------------------------------------------------
function Library:CopyConfigToClipboard()
	local setter = setclipboard or toclipboard or (syn and syn.write_clipboard)
	if not setter then return false, "executor has no clipboard access" end
	local ok = pcall(setter, Library:GetConfigString())
	if not ok then return false, "clipboard write failed" end
	return true
end

function Library:LoadConfigFromClipboard()
	local getter = getclipboard or get_clipboard
	if not getter then return false, "executor cannot read the clipboard — paste into the box instead" end
	local ok, text = pcall(getter)
	if not ok or typeof(text) ~= "string" or text == "" then return false, "clipboard is empty" end
	return Library:LoadConfigString(text)
end

----------------------------------------------------------------------
-- autoload
----------------------------------------------------------------------
function Library:GetAutoloadConfig()
	if not HasFileAPI() then return nil end
	local okExists, exists = pcall(isfile, AUTOLOAD_FILE)
	if not okExists or not exists then return nil end
	local okRead, content = pcall(readfile, AUTOLOAD_FILE)
	if not okRead then return nil end
	return CleanName(tostring(content))
end

function Library:SetAutoloadConfig(name)
	name = CleanName(name)
	if not name then return false, "no config selected" end
	if not EnsureFolders() then return false, "no file API in this executor" end
	if not Library:ConfigExists(name) then return false, "config not found" end
	if not pcall(writefile, AUTOLOAD_FILE, name) then return false, "could not write autoload" end
	return true, name
end

function Library:ClearAutoloadConfig()
	if not HasFileAPI() then return false, "no file API in this executor" end
	if delfile then
		local okExists, exists = pcall(isfile, AUTOLOAD_FILE)
		if okExists and exists then pcall(delfile, AUTOLOAD_FILE) end
	else
		pcall(writefile, AUTOLOAD_FILE, "")
	end
	return true
end

-- Call once, AFTER the whole menu is built: every element has to exist
-- before its saved value can be restored.
function Library:RunAutoload()
	local name = Library:GetAutoloadConfig()
	if not name then return false, "no autoload config set" end
	if not Library:ConfigExists(name) then
		Library:ClearAutoloadConfig()
		return false, ("autoload config '%s' is missing"):format(name)
	end
	local ok, result = Library:LoadConfig(name)
	if not ok then return false, result end
	return true, name, result
end

----------------------------------------------------------------------
-- auto execute on teleport
--
-- A teleport tears the whole Lua state down, so nothing of ours survives it.
-- Executors provide queue_on_teleport: a script string handed to the NEXT
-- place the client lands in. That covers a rejoin, a server hop, an AFK
-- system punting you to a lobby, and a game teleporting you between places.
--
-- The queued script is the loader itself, so on arrival it runs, rebuilds the
-- menu, autoloads the config, and re-queues for the hop after that.
----------------------------------------------------------------------
local AUTOEXEC_FILE = FOLDER .. "/autoexec.txt"

local function GetQueueFn()
	return (syn and syn.queue_on_teleport)
		or queue_on_teleport
		or queueonteleport
		or (fluxus and fluxus.queue_on_teleport)
end

function Library.HasQueueOnTeleport()
	return GetQueueFn() ~= nil
end

local LOCAL_COPY = FOLDER .. "/kairo.lua"
Library.LocalCopyPath = LOCAL_COPY

function Library:BuildExecuteSource(url)
	url = tostring(url or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if url == "" then return nil end
	return ("loadstring(game:HttpGet(\"%s\"))()"):format(url)
end

-- Saves the hub's own source next to the configs so auto execute needs no URL
-- at all. Call it with the script text if you have it to hand.
function Library:SaveLocalCopy(source)
	if not HasFileAPI() then return false, "no file API in this executor" end
	if typeof(source) ~= "string" or #source < 32 then return false, "no source given" end
	if not EnsureFolders() then return false, "could not create the config folder" end
	if not pcall(writefile, LOCAL_COPY, source) then return false, "could not write the local copy" end
	return true, LOCAL_COPY
end

function Library:HasLocalCopy()
	if not HasFileAPI() then return false end
	local ok, exists = pcall(isfile, LOCAL_COPY)
	return ok and exists or false
end

-- Works out what to queue. A hosted URL wins; otherwise a local copy on disk
-- is re-read on arrival, which needs no network and no configuration.
function Library:ResolveExecuteSource(url)
	local built = Library:BuildExecuteSource(url)
	if built then return built end

	if Library:HasLocalCopy() then
		return ("loadstring(readfile(\"%s\"))()"):format(LOCAL_COPY)
	end

	return nil, "set KAIRO_URL at the top of your menu, or save a local copy"
end

-- Returns enabled, source. The file holding a source IS the "on" switch.
function Library:GetAutoExecute()
	if not HasFileAPI() then return false, nil end
	local okExists, exists = pcall(isfile, AUTOEXEC_FILE)
	if not okExists or not exists then return false, nil end
	local okRead, content = pcall(readfile, AUTOEXEC_FILE)
	if not okRead then return false, nil end
	content = tostring(content):gsub("^%s+", ""):gsub("%s+$", "")
	if content == "" then return false, nil end
	return true, content
end

function Library:SetAutoExecute(enabled, source)
	if not HasFileAPI() then return false, "no file API in this executor" end

	if not enabled then
		if delfile then
			local okExists, exists = pcall(isfile, AUTOEXEC_FILE)
			if okExists and exists then pcall(delfile, AUTOEXEC_FILE) end
		else
			pcall(writefile, AUTOEXEC_FILE, "")
		end
		return true
	end

	source = source and tostring(source) or nil
	if not source or source:gsub("%s", "") == "" then
		return false, "set the script URL first"
	end
	if not EnsureFolders() then return false, "could not create the config folder" end
	if not pcall(writefile, AUTOEXEC_FILE, source) then
		return false, "could not write the autoexec file"
	end
	return true, source
end

-- Hands the stored source to the executor's teleport queue. Safe to call
-- repeatedly; the queue is consumed by the next teleport.
function Library:QueueAutoExecute()
	local q = GetQueueFn()
	if not q then return false, "this executor has no queue_on_teleport" end

	local enabled, source = Library:GetAutoExecute()
	if not enabled then return false, "auto execute is off" end

	local ok, err = pcall(q, source)
	if not ok then return false, "queue call failed: " .. tostring(err) end
	return true, source
end

-- Queue at startup, and again the moment a teleport begins. The second call
-- covers executors that clear the queue once it has been consumed.
function Library:InitAutoExecute()
	local enabled = Library:GetAutoExecute()
	if not enabled then return false, "auto execute is off" end

	local ok, err = Library:QueueAutoExecute()

	Connect(LocalPlayer.OnTeleport, function(state)
		if state == Enum.TeleportState.Started
		or state == Enum.TeleportState.InProgress then
			pcall(function() Library:QueueAutoExecute() end)
		end
	end)

	return ok, err
end

----------------------------------------------------------------------
-- self test
--
-- Exercises every registered element through its own API and reports what
-- failed. Values are restored afterwards, so it is safe to run on a live menu.
----------------------------------------------------------------------
function Library:SelfTest()
	local report = { passed = 0, failed = 0, issues = {} }

	local function check(name, ok, detail)
		if ok then
			report.passed += 1
		else
			report.failed += 1
			table.insert(report.issues, ("%s: %s"):format(name, detail or "failed"))
		end
	end

	for flag, option in pairs(Library.Options) do
		local t = option.Type
		local before = option.Value
		local okCall, err = pcall(function()
			if t == "Toggle" then
				option:Set(not before, true)
				assert(option:Get() == (not before), "value did not change")
				option:Set(before, true)
			elseif t == "Slider" then
				option:Set(before, true)
				assert(type(option:Get()) == "number", "value is not a number")
			elseif t == "Dropdown" then
				local items = option.Items
				if items and #items > 0 and typeof(before) ~= "table" then
					option:Set(items[1], true)
					assert(option:Get() == items[1], "selection did not take")
					option:Set(before, true)
				end
			elseif t == "Textbox" then
				option:Set(tostring(before), true)
			elseif t == "Colorpicker" then
				option:Set(before, true)
				assert(typeof(option:Get()) == "Color3", "value is not a Color3")
			elseif t == "Keybind" then
				option:Set(option.Key, true)
			end
		end)
		check(("%s (%s)"):format(flag, tostring(t)), okCall, err)
	end

	-- round-trip the whole config
	local okCfg, cfgErr = pcall(function()
		local snapshot = Library:GetConfigString()
		local ok = Library:LoadConfigString(snapshot)
		assert(ok, "config round-trip rejected its own output")
	end)
	check("config round-trip", okCfg, cfgErr)

