----------------------------------------------------------------------
-- dependencies + search
----------------------------------------------------------------------
local searchQuery = ""

-- An element is visible when its dependencies hold AND it matches the search.
local function EvaluateVisibility()
	for _, el in ipairs(Library.Elements) do
		local ok = true

		if el.Depends then
			for flag, want in pairs(el.Depends) do
				local have = Library.Flags[flag]
				if typeof(want) == "function" then
					ok = ok and want(have) and true or false
				else
					ok = ok and (have == want)
				end
				if not ok then break end
			end
		end

		if ok and searchQuery ~= "" then
			ok = string.find(el.SearchText or "", searchQuery, 1, true) ~= nil
		end

		if el.Row and el.Row.Parent then el.Row.Visible = ok end
	end

	-- a groupbox with nothing visible inside it hides too
	for _, win in ipairs(Library.Windows) do
		for _, tab in ipairs(win.Tabs) do
			for _, gb in ipairs(tab.Groupboxes) do
				local any = false
				for _, c in ipairs(gb.Container:GetChildren()) do
					if c:IsA("Frame") and c.Visible then any = true break end
				end
				if gb.Frame and gb.Frame.Parent then
					gb.Frame.Visible = any or searchQuery == ""
				end
			end
		end
	end
end
Library.EvaluateVisibility = EvaluateVisibility

function Library:SetSearch(query)
	searchQuery = tostring(query or ""):lower()
	EvaluateVisibility()
end

-- Called at the end of every element constructor: wires dependencies,
-- tooltips and search, and makes any :Set re-evaluate the dependency graph.
local function RegisterElement(obj, cfg, row, searchText, groupbox)
	obj.Row        = row
	obj.Depends    = cfg.Depends
	obj.SearchText = tostring(searchText or ""):lower()
	obj.Groupbox   = groupbox

	table.insert(Library.Elements, obj)

	if cfg.Tooltip and row then
		Connect(row.MouseEnter, function() ShowTooltip(cfg.Tooltip) end)
		Connect(row.MouseLeave, function() HideTooltip() end)
	end

	if obj.Set then
		local original = obj.Set
		obj.Set = function(self, ...)
			local result = original(self, ...)
			EvaluateVisibility()
			return result
		end
	end

	return obj
end

----------------------------------------------------------------------
-- splash / loading screen
--
-- Direction: an engineering title block. Flat near-black, nothing centred
-- except the target plate, no glow or spinner. The wordmark fills with the
-- accent as progress runs — that reveal is the only moving part.
----------------------------------------------------------------------
local function CollectFadeables(root)
	local items = {}

	local function add(inst)
		local props
		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
			props = { BackgroundTransparency = inst.BackgroundTransparency, TextTransparency = inst.TextTransparency }
		elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			props = { BackgroundTransparency = inst.BackgroundTransparency, ImageTransparency = inst.ImageTransparency }
		elseif inst:IsA("Frame") then
			props = { BackgroundTransparency = inst.BackgroundTransparency }
		elseif inst:IsA("UIStroke") then
			props = { Transparency = inst.Transparency }
		end
		if props then table.insert(items, { inst = inst, props = props }) end
	end

	add(root)
	for _, d in ipairs(root:GetDescendants()) do add(d) end
	return items
end

